From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lutvzn <106083845+lutvzn@users.noreply.github.com>
Date: Thu, 15 Oct 2026 21:27:18 -0300
Subject: [PATCH 3/3] qualcommax: ipq50xx: redmi-ax3000: shrink ath11k DP RX
 rings

The 256 MiB board has only ~17 MiB available once both radios have
probed. Use 2048 RX buffers (default 4096), 128 monitor buffers
(default 4096, only used in monitor mode) and 512 monitor status
buffers (default 1024).
---
 .../arch/arm64/boot/dts/qcom/ipq5018-redmi-ax3000.dts    | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-redmi-ax3000.dts b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-redmi-ax3000.dts
index b52de776bf..28d069cd5d 100644
--- a/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-redmi-ax3000.dts
+++ b/target/linux/qualcommax/files/arch/arm64/boot/dts/qcom/ipq5018-redmi-ax3000.dts
@@ -394,6 +394,9 @@
  * 256 MiB of RAM: use the low-memory firmware profile (mode 2), as the
  * vendor firmware does (qcom,tgt-mem-mode = <2>). The BDF/M3 dump
  * addresses are the vendor values for mode 2.
+ * Also shrink the host RX rings that ath11k fills with 2 KiB buffers at
+ * probe time (defaults 4096/4096/1024; the monitor rings only matter for
+ * monitor mode), which saves ~35 MiB with both radios.
  */
 &wifi {
 	status = "okay";
@@ -404,6 +407,9 @@
 	qcom,ath11k-calibration-variant = "Xiaomi-Redmi-AX3000";
 	qcom,ath11k-fw-memory-mode = <2>;
 	qcom,bdf-addr = <0x4c400000>;
+	qcom,ath11k-rx-buf-ring-size = <2048>;
+	qcom,ath11k-mon-buf-ring-size = <128>;
+	qcom,ath11k-mon-status-ring-size = <512>;
 };
 
 &wifi1 {
@@ -416,4 +422,7 @@
 	qcom,ath11k-fw-memory-mode = <2>;
 	qcom,bdf-addr = <0x4d100000>;
 	qcom,m3-dump-addr = <0x4df00000>;
+	qcom,ath11k-rx-buf-ring-size = <2048>;
+	qcom,ath11k-mon-buf-ring-size = <128>;
+	qcom,ath11k-mon-status-ring-size = <512>;
 };
