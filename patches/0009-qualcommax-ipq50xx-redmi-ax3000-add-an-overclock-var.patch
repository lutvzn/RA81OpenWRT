+++ b/target/linux/qualcommax/image/ipq50xx.mk
@@ -886,6 +886,17 @@ define Device/xiaomi_redmi-ax3000
 endef
 TARGET_DEVICES += xiaomi_redmi-ax3000
 
+# The same board with CPU clocks above 1008 MHz, chosen in System -> CPU Clock
+# (luci-app-cpuclock). Same compatible as above, so sysupgrade goes both ways.
+define Device/xiaomi_redmi-ax3000-oc
+	$(call Device/xiaomi_redmi-ax3000)
+	DEVICE_VARIANT := (RA81, overclock)
+	DEVICE_DTS := ipq5018-redmi-ax3000-oc
+	SUPPORTED_DEVICES := xiaomi,redmi-ax3000 redmi,ax3000
+	DEVICE_PACKAGES += luci-app-cpuclock
+endef
+TARGET_DEVICES += xiaomi_redmi-ax3000-oc
+
 define Device/xiaomi_redmi-ax5400
 	$(call Device/xiaomi_ipq50xx_ax_base)
 	DEVICE_MODEL := Redmi AX5400
diff --git a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
index a4edbcc774..ca1c83bde8 100644
--- a/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
+++ b/target/linux/qualcommax/ipq50xx/base-files/lib/upgrade/platform.sh
@@ -403,6 +403,11 @@ xiaomi_redmi_ax3000_pre_upgrade() {
 	# written yet: a hang or a crash here leaves the running slot intact.
 	v "$(grep MemAvailable /proc/meminfo) before freeing memory"
 
+	# Overclock image: write the flash at the rated 1008 MHz. Switching
+	# boost off drops the clock limit to the highest non-boost point.
+	[ -w /sys/devices/system/cpu/cpufreq/boost ] &&
+		echo 0 > /sys/devices/system/cpu/cpufreq/boost
+
 	echo 2048 > /proc/sys/vm/min_free_kbytes
 
 	# Unloading ath11k_ahb stops the Q6, do not wait for it forever
-- 
