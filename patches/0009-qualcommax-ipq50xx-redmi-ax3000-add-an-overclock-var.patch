diff --git a/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-oc.dts b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-oc.dts
new file mode 100644
index 0000000000..42213d80be
--- /dev/null
+++ b/target/linux/qualcommax/dts/ipq5018-redmi-ax3000-oc.dts
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
+
+/*
+ * Redmi AX3000 (RA81), overclock variant: the same board with CPU operating
+ * points above the rated 1008 MHz. Same compatible, so the board name, the
+ * board scripts and sysupgrade between the two images are unchanged.
+ *
+ * The extra points are turbo-mode: cpufreq-dt lists them as boost
+ * frequencies, which the kernel leaves unused until boost is switched on
+ * (/sys/devices/system/cpu/cpufreq/boost). The image boots, and failsafe
+ * runs, at 1008 MHz; /etc/init.d/cpuclock (luci-app-cpuclock, System ->
+ * CPU Clock) enables boost and caps scaling_max_freq to the configured
+ * clock. The a53pll steps in 24 MHz (L x 24 MHz), always at 1.1 V: there
+ * is no CPU regulator.
+ *
+ * Measured on one IPQ5000 under network load plus a RAM tester (2026-11-12):
+ * 1104, 1200, 1224 and 1248 MHz ran 15 min with no error (79-83 C); 1272 MHz
+ * cleared a bit in RAM after 6 min; 1296 MHz reset the board within seconds.
+ * 1056 and 1152 MHz lie between tested points. Other chips may fail lower.
+ */
+
+#include "ipq5018-redmi-ax3000.dts"
+
+&cpu_opp_table {
+	opp-1056000000 {
+		opp-hz = /bits/ 64 <1056000000>;
+		opp-microvolt = <1100000>;
+		clock-latency-ns = <200000>;
+		turbo-mode;
+	};
+
+	opp-1104000000 {
+		opp-hz = /bits/ 64 <1104000000>;
+		opp-microvolt = <1100000>;
+		clock-latency-ns = <200000>;
+		turbo-mode;
+	};
+
+	opp-1152000000 {
+		opp-hz = /bits/ 64 <1152000000>;
+		opp-microvolt = <1100000>;
+		clock-latency-ns = <200000>;
+		turbo-mode;
+	};
+
+	opp-1200000000 {
+		opp-hz = /bits/ 64 <1200000000>;
+		opp-microvolt = <1100000>;
+		clock-latency-ns = <200000>;
+		turbo-mode;
+	};
+
+	opp-1248000000 {
+		opp-hz = /bits/ 64 <1248000000>;
+		opp-microvolt = <1100000>;
+		clock-latency-ns = <200000>;
+		turbo-mode;
+	};
+};
diff --git a/target/linux/qualcommax/image/ipq50xx.mk b/target/linux/qualcommax/image/ipq50xx.mk
index 9b52553b7d..1056b23f17 100644
