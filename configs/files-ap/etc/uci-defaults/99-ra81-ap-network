#!/bin/sh
# EXAMPLE first-boot profile - edit the addresses for your network before building
# with "scripts/build.sh --files configs/files-ap".
#
# Turns the router into a bridged access point on an existing LAN:
# bridged access point at 10.0.0.3/23 (gateway and DNS 10.0.0.1), uplink on a
# LAN port, no DHCP/RA server, WAN port bridged into br-lan, and 192.168.1.1/24
# kept as a management alias. Wi-Fi is left at the OpenWrt defaults (disabled).

brdev=$(uci -q show network | sed -n "s/^network\.\([^.]*\)\.name='br-lan'$/\1/p" | head -n1)

uci -q batch <<'UCI'
set network.lan.ipaddr='10.0.0.3'
set network.lan.netmask='255.255.254.0'
set network.lan.gateway='10.0.0.1'
delete network.lan.dns
add_list network.lan.dns='10.0.0.1'
set network.mgmt=interface
set network.mgmt.device='br-lan'
set network.mgmt.proto='static'
set network.mgmt.ipaddr='192.168.1.1'
set network.mgmt.netmask='255.255.255.0'
set network.wan.disabled='1'
set network.wan6.disabled='1'
set dhcp.lan.ignore='1'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ra='disabled'
UCI

if [ -n "$brdev" ]; then
	uci -q del_list network."$brdev".ports='wan'
	uci -q add_list network."$brdev".ports='wan'
fi

uci commit network
uci commit dhcp
exit 0
