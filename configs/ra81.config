# Xiaomi Redmi AX3000 (RA81) - OpenWrt + NSS offload diffconfig (expanded by "make defconfig")
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax3000=y

# Also produce an initramfs FIT (RAM boot via U-Boot TFTP + UART, no flashing)
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# Web UI
CONFIG_PACKAGE_luci=y

# NSS runtime and the dsa plane; =y, not =m: it is the package that arms the
# firmware (kmod-qca-dwmac-nss, -drv, -ecm, -vlan-mgr, qca-dsa-nss).
# The rest follows the fork's release groups "common" + "256m"
# (.github/ci/ipq50xx/ in the base tree).
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

# ath11k with the NSS patches (Wi-Fi offload)
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_PACKAGE_ATH_DEBUG=y

# 256 MiB of RAM: ath11k 256M profile (512M + smaller RXDMA rings), NSS LOW
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y
# Smaller ath11k host TX arrays/pools, CE5 buffers and private RX fragment
# caches while the NSS plane is active (IPQ5018/QCN6122 only)
CONFIG_ATH11K_NSS_MEM_PROFILE_256M=y

# SQM in the NSS firmware (nss-edma.qos); shipped with its queue disabled
CONFIG_NSS_DRV_SHAPER_ENABLE=y
CONFIG_NSS_DRV_IGS_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_sqm-scripts-nss=y
CONFIG_PACKAGE_tc-full=y

CONFIG_PACKAGE_ip-full=y

# Built as =m: not in the image, but in this build's package repository
# (copied to out/<dir>/packages/, published with each release), so they can
# be installed with apk on an image from the same build. No USB port, so no
# USB or local-disk filesystem modules. Selecting kmod-gre or kmod-l2tp, even
# =m, also builds the GRE and L2TPv2 handlers into qca-nss-drv
# (feeds/nss/qca-nss-drv/Makefile), as in the fork's releases. Any change here
# changes the kernel configuration: scripts/build.sh then rebuilds the
# out-of-tree kernel modules.
CONFIG_PACKAGE_kmod-wireguard=m
CONFIG_PACKAGE_kmod-tun=m
CONFIG_PACKAGE_kmod-gre=m
CONFIG_PACKAGE_kmod-vxlan=m
CONFIG_PACKAGE_kmod-l2tp=m
CONFIG_PACKAGE_kmod-bonding=m
CONFIG_PACKAGE_kmod-nft-queue=m
CONFIG_PACKAGE_kmod-nft-socket=m
CONFIG_PACKAGE_kmod-nft-tproxy=m
CONFIG_PACKAGE_kmod-inet-diag=m
CONFIG_PACKAGE_kmod-netlink-diag=m
CONFIG_PACKAGE_kmod-sched-cake=m
CONFIG_PACKAGE_kmod-fs-nfs=m
CONFIG_PACKAGE_kmod-fs-cifs=m
CONFIG_PACKAGE_kmod-nls-utf8=m
# Not in the official feeds: Status -> NSS Offload in LuCI
CONFIG_PACKAGE_luci-app-nss=m
