# Xiaomi Redmi AX3000 (RA81) - OpenWrt 25.12 diffconfig (expanded by "make defconfig")
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_xiaomi_redmi-ax3000=y

# Also produce an initramfs FIT (RAM boot via U-Boot TFTP + UART, no flashing)
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# Web UI
CONFIG_PACKAGE_luci=y
